# ─── Supabase (Required) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Sentry Error Observability (Optional) ────────────────────────────────────
# Fill with your Sentry project DSN (e.g., https://xxx@xxx.ingest.sentry.io/xxx)
# Create a Sentry account & project at https://sentry.io to get your DSN.
NEXT_PUBLIC_SENTRY_DSN=

# ─── External APIs (Optional) ─────────────────────────────────────────────────
TICKETMASTER_API_KEY=
SETLISTFM_API_KEY=
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
